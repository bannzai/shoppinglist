GoogleService-Info.plist

lib/secret/secret.dart

# Functions の Makefile secret が書き出すサービスアカウント鍵 (Functions の source の外に置く。Issue #675)
firebase/.secret/

# iOS のローカルシークレット（APIキー実値）
ios/Flutter/Secret.xcconfig

# make secret (scripts/google-maps-secret.sh) が書き出す Google Maps クライアントキー (ADR 0035)
ios/Flutter/GoogleMaps.xcconfig
android/google-maps.properties

# Functions の .env (値は Secret Manager / SecChain が正。global gitignore だけに頼らない)
firebase/functions/.env
firebase/functions/.env.*

maestro/screenshots/
maestro/test-results/
screenshots/
# ストア提出用スクリーンショットは成果物として管理する (fastlane deliver の入力)
!ios/fastlane/screenshots/

# UI research artifacts
.local/

ios/build

# Temporary PR body files
.pr_body_tmp_*

# 一時ファイル置き場 (run-qa のプロンプト・ログ出力先を含む)
tmp/

