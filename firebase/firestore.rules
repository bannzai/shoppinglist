rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isUserAuth(id) {
      return request.auth != null && request.auth.uid == id;
    }

    function isMember(memberUserIDs) {
      return request.auth != null && request.auth.uid in memberUserIDs;
    }

    match /users/{userID} {
      allow read: if isUserAuth(userID);
      allow create, update: if isUserAuth(userID);
    }

    // グループ招待: 書き込みは Functions Admin SDK 経由のみ
    match /groupInvitations/{invitationID} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // カップル
    match /groups/{groupID} {
      allow read, update: if isMember(resource.data.memberUserIDs);
      allow create: if isMember(request.resource.data.memberUserIDs);

      function isGroupMember() {
        return isMember(get(/databases/$(database)/documents/groups/$(groupID)).data.memberUserIDs);
      }

      match /shoppingLists/{shoppingListID} {
        allow read, write: if isGroupMember();

        match /items/{itemID} {
          allow read, write: if isGroupMember();
        }
      }
    }
  }
}
