rules_version = '2';

// 設計方針:
// JWT (Firebase Auth) の本人認証 + リソース所有判定のみを行い、データ内容に踏み込んだ
// ガード（プレミアム判定・期間判定・フィールド diff 等）は実装しない。詳細は
// `.claude/rules/firestore-rules-simplicity.md` を参照。
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function isUserAuth(id) {
      return isAuth() && request.auth.uid == id;
    }

    // デバッグユーザーID（{uid}_debug_1 等）を実ユーザーが操作できるかチェック
    function isDebugUserOf(userDocID) {
      return isAuth() && userDocID.matches(request.auth.uid + '_debug_[0-9]+');
    }

    function isMember(memberUserIDs) {
      return isAuth() && request.auth.uid in memberUserIDs;
    }

    match /users/{userID} {
      // developerToken フィールドは Cloud Functions の dev only 関数 (grantPromotionalPremium 等)
      // のユーザー単位ガードに使われる。dart-define SHOPPINGLIST_DEVELOPER_TOKEN を持つ開発者ビルドでのみ
      // クライアント (UserDeveloperTokenSync) が upsert する。本人以外のアクセスは下記の
      // isUserAuth(userID) || isDebugUserOf(userID) で既に拒否されている。
      allow read, write: if isUserAuth(userID) || isDebugUserOf(userID);

      match /privates/{privateID} {
        allow read, write: if isUserAuth(userID) || isDebugUserOf(userID);
      }

      match /aiUsage/{yearMonth} {
        allow read, write: if isUserAuth(userID) || isDebugUserOf(userID);
      }
    }

    // グループ招待: クライアントから直接 read/write しない (Functions Admin SDK 経由のみ)
    match /groupInvitations/{invitationID} {
      allow read, write: if false;
    }

    // お問い合わせ: クライアントから直接 read/write しない (submitInquiry Function の Admin SDK 経由のみ)。
    // ユーザーデータのスナップショットを含むため、本人にも直接読ませない。
    match /inquiries/{inquiryID} {
      allow read, write: if false;
    }

    match /groups/{groupID} {
      allow read, update, delete: if isMember(resource.data.memberUserIDs);
      // グループ作成は Cloud Functions (createGroup) 経由でのみ許可する
      allow create: if false;

      function isGroupMember() {
        return isMember(get(/databases/$(database)/documents/groups/$(groupID)).data.memberUserIDs);
      }

      // userCategoryAxes / categories はユーザー所有のまま、同じグループのメンバーが
      // 自分の設定へ取り込めるよう読み取りのみ共有する。
      function isCategoryDataOwner(userID) {
        return isUserAuth(userID) || isDebugUserOf(userID);
      }

      function isCurrentGroupMember(userID) {
        return userID in get(/databases/$(database)/documents/groups/$(groupID)).data.memberUserIDs;
      }

      match /userProfiles/{profileID} {
        allow read, write: if isGroupMember();
      }

      match /shoppingLocations/{locationID} {
        allow read, write: if isGroupMember();
      }

      match /userCategoryAxes/{axisID} {
        allow read: if isGroupMember() && isCurrentGroupMember(resource.data.userID);
        allow create: if isGroupMember() && isCategoryDataOwner(request.resource.data.userID);
        allow update: if isGroupMember()
          && isCategoryDataOwner(resource.data.userID)
          && request.resource.data.userID == resource.data.userID;
        allow delete: if isGroupMember() && isCategoryDataOwner(resource.data.userID);

        match /categories/{categoryID} {
          allow read: if isGroupMember()
            && isCurrentGroupMember(resource.data.userID)
            && exists(/databases/$(database)/documents/groups/$(groupID)/userCategoryAxes/$(axisID))
            && get(/databases/$(database)/documents/groups/$(groupID)/userCategoryAxes/$(axisID)).data.userID == resource.data.userID;
          allow create: if isGroupMember() && isCategoryDataOwner(request.resource.data.userID);
          allow update: if isGroupMember()
            && isCategoryDataOwner(resource.data.userID)
            && request.resource.data.userID == resource.data.userID;
          allow delete: if isGroupMember() && isCategoryDataOwner(resource.data.userID);
        }
      }

      match /shoppingLists/{shoppingListID} {
        allow read, write: if isGroupMember();

        match /items/{itemID} {
          allow read, write: if isGroupMember();
        }

        // レシートのメタデータ（金額・メモ）。画像本体は Storage に保存し
        // Cloud Functions 経由でのみアクセスする（storage.rules を参照）。
        // レシートは登録・編集のみで削除は行わないため、delete は許可しない。
        match /receipts/{receiptID} {
          allow read, create, update: if isGroupMember();
        }

        // 「写真から追加」の元画像メタデータ（Issue #530）。作成・削除は
        // Cloud Functions (generateShoppingListItemsFromImage, Admin SDK) 経由のみで、
        // クライアントは読み取りのみ（画像本体は Storage。storage.rules を参照）。
        match /sourceImages/{sourceImageID} {
          allow read: if isGroupMember();
        }
      }
    }
  }
}
