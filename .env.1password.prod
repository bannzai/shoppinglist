# 1Password secret references (prod): 本番の値を使う操作だけ op run --env-file .env.1password.prod -- <command> で渡す。
# 既定の .env.1password には入れない (開発コマンドの子プロセスに本番の値を渡さないため)。値は書かない。
REVENUECAT_SECRET_API_KEY_PROD=op://shoppinglist/REVENUECAT_SECRET_API_KEY_PROD/password
REVENUECAT_TEST_STORE_API_KEY_PROD=op://shoppinglist/REVENUECAT_TEST_STORE_API_KEY_PROD/password
GOOGLE_GENAI_API_KEY_PROD=op://shoppinglist/GOOGLE_GENAI_API_KEY_PROD/password
