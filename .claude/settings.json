{
  "plansDirectory": ".plans",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath // empty' | { read -r f; case \"$f\" in *.dart) cd \"$CLAUDE_PROJECT_DIR\" && dart format ./ ;; esac; } 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "dart format ./ 実行中..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(gh-r2-image:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git rev-parse:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(date:*)",
      "Bash(bash /Users/bannzai/.claude/skills/run-qa/scripts/affected_features.sh:*)",
      "Bash(bash /Users/bannzai/.claude/skills/run-qa/scripts/mark_verified.sh:*)",
      "Bash(sim-boot:*)",
      "Bash(sim-list:*)",
      "Bash(sim-shutdown:*)",
      "Bash(xcrun simctl:*)",
      "Bash(maestro:*)",
      "mcp__mobile",
      "Bash(flutter:*)",
      "Bash(dart:*)",
      "Bash(bash /Users/bannzai/.claude/skills/setup-qa/scripts/sync_evidence.sh:*)"
    ]
  }
}
