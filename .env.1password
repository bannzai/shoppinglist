# 1Password secret references: op run --env-file .env.1password -- <command> が環境変数として渡す。
# 値は書かない。op://<vault>/<item>/<field> の参照だけを書く。
ANDROID_KEYSTORE_PASSWORD=op://shoppinglist/ANDROID_KEYSTORE_PASSWORD/password
REVENUECAT_SECRET_API_KEY=op://shoppinglist/REVENUECAT_SECRET_API_KEY/password
REVENUECAT_SECRET_API_KEY_DEV=op://shoppinglist/REVENUECAT_SECRET_API_KEY_DEV/password
REVENUECAT_SECRET_API_KEY_PROD=op://shoppinglist/REVENUECAT_SECRET_API_KEY_PROD/password
REVENUECAT_TEST_STORE_API_KEY=op://shoppinglist/REVENUECAT_TEST_STORE_API_KEY/password
REVENUECAT_TEST_STORE_API_KEY_DEV=op://shoppinglist/REVENUECAT_TEST_STORE_API_KEY_DEV/password
REVENUECAT_TEST_STORE_API_KEY_PROD=op://shoppinglist/REVENUECAT_TEST_STORE_API_KEY_PROD/password
