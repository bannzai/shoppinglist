#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// dev/prod 識別子分離(Issue #410 / ADR 0030)。Runner の entitlements が参照する
// $(APP_GROUP_ID) / $(KEYCHAIN_ACCESS_GROUP) の dev 値。Debug config = dev。
// Runner Release/Profile config は Release.xcconfig を include するため prod 値はそちらに定義。
// Widget ターゲットはこの xcconfig を include しないため pbxproj の各 config に直接定義する。
APP_BUNDLE_IDENTIFIER = com.bannzai.shoppinglist.dev
APP_GROUP_ID = group.com.bannzai.shoppinglist.dev
KEYCHAIN_ACCESS_GROUP = com.bannzai.shoppinglist.dev

// Google Maps クライアントキー(dev)。Info.plist の GMSApiKey=$(GOOGLE_MAPS_API_KEY) が参照。
// 値は GCP Secret Manager (shoppinglist-dev-b2787 の google-maps-sdk-ios-apikey) が正で、リポジトリには置かない。
// `make secret` が gitignore 済みの GoogleMaps.xcconfig に GOOGLE_MAPS_API_KEY_IOS_DEV / _PROD を書き出す(ADR 0035)。
// ファイルが無い時は空になり、地図は描画されないがビルドは通る。
#include? "GoogleMaps.xcconfig"
GOOGLE_MAPS_API_KEY = $(GOOGLE_MAPS_API_KEY_IOS_DEV)

// Google Sign-In OAuth クライアント(dev, Issue #504)。dev/prod で Firebase プロジェクトが異なり
// OAuth クライアントも別になるため、Info.plist の GIDClientID / CFBundleURLSchemes は xcconfig 経由で注入する。
// 値は shoppinglist-dev-b2787 の GoogleService-Info.plist の CLIENT_ID / REVERSED_CLIENT_ID と一致させる。
GID_CLIENT_ID = 764733922439-kj775mlhnj87udbc8pl0ahr05lti791k.apps.googleusercontent.com
GID_REVERSED_CLIENT_ID = com.googleusercontent.apps.764733922439-kj775mlhnj87udbc8pl0ahr05lti791k

// AdMob App ID (Issue #77)。Info.plist の GADApplicationIdentifier=$(ADMOB_APP_ID) が参照。
// AdMob 自体は Issue #540 で撤去済み(SDK なしでは Info.plist の値は読まれない)が、
// 再導入に備えて App ID の Env は意図的に残している。
// クライアント埋め込み前提の公開情報のため直書き。
ADMOB_APP_ID = ca-app-pub-9127772965271297~9433558962

