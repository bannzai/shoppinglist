#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"
#include "Secret.xcconfig"

// dev/prod 識別子分離(Issue #410 / ADR 0030)。Runner の entitlements が参照する
// $(APP_GROUP_ID) / $(KEYCHAIN_ACCESS_GROUP) の prod 値。Release/Profile config = prod。
APP_BUNDLE_IDENTIFIER = com.bannzai.shoppinglist
APP_GROUP_ID = group.com.bannzai.shoppinglist
KEYCHAIN_ACCESS_GROUP = com.bannzai.shoppinglist

