#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

// dev/prod 識別子分離(Issue #410 / ADR 0030)。Runner の entitlements が参照する
// $(APP_GROUP_ID) / $(KEYCHAIN_ACCESS_GROUP) の prod 値。Release/Profile config = prod。
APP_BUNDLE_IDENTIFIER = com.bannzai.shoppinglist
APP_GROUP_ID = group.com.bannzai.shoppinglist
KEYCHAIN_ACCESS_GROUP = com.bannzai.shoppinglist

// Google Maps クライアントキー(prod)。Info.plist の GMSApiKey=$(GOOGLE_MAPS_API_KEY) が参照。
// クライアント埋め込み前提の公開情報のため直書き。GCP 側でアプリ制限(bundleId)+API制限(Maps SDK for iOS)を必須とする。
GOOGLE_MAPS_API_KEY = AIzaSyDhdAhZIgKuIwjsQesJTlayEWnjXx-fvcI

// Google Sign-In OAuth クライアント(prod, Issue #504)。dev/prod で Firebase プロジェクトが異なり
// OAuth クライアントも別になるため、Info.plist の GIDClientID / CFBundleURLSchemes は xcconfig 経由で注入する。
// 値は shoppinglist-prod-857bb の GoogleService-Info.plist の CLIENT_ID / REVERSED_CLIENT_ID と一致させる。
GID_CLIENT_ID = 323773689605-k2hfptltunveoigmrqfcsln2l0p630m0.apps.googleusercontent.com
GID_REVERSED_CLIENT_ID = com.googleusercontent.apps.323773689605-k2hfptltunveoigmrqfcsln2l0p630m0

// AdMob App ID (Issue #77)。Info.plist の GADApplicationIdentifier=$(ADMOB_APP_ID) が参照。
// AdMob 自体は Issue #540 で撤去済み(SDK なしでは Info.plist の値は読まれない)が、
// 再導入に備えて App ID の Env は意図的に残している。
// クライアント埋め込み前提の公開情報のため直書き。
ADMOB_APP_ID = ca-app-pub-9127772965271297~9433558962

