# Uncomment this line to define a global platform for your project
# アプリの最低 iOS バージョン。post_install で pod の deployment target の下限にも使う
IOS_PLATFORM_VERSION = '16.0'
platform :ios, IOS_PLATFORM_VERSION


# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Firestoreのビルド高速化: プリコンパイル済みフレームワークを使用
  # バージョンは firebase_core の firebase_sdk_version.rb から動的取得
  require File.expand_path(File.join('.symlinks', 'plugins', 'firebase_core', 'ios', 'firebase_sdk_version.rb'), File.dirname(File.realpath(__FILE__)))
  pod 'FirebaseFirestore', :git => 'https://github.com/invertase/firestore-ios-sdk-frameworks.git', :tag => firebase_sdk_version!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end

  # Widget拡張(ShoppingListWidgetExtension)は Runner にネストし search paths のみ継承する。
  # 拡張を独立した CocoaPods ターゲットにすると GoogleUtilities / GTMSessionFetcher 等が
  # ターゲットごとに二重ビルドされ、archive 時に
  #   "Multiple commands produce '.../UninstalledProducts/.../GoogleUtilities.framework'"
  # で失敗する（Firebase 公式推奨も「Firebase は host app のみに置き、拡張は host のフレームワークを
  # リンクする」）。search paths は継承されるのでコンパイルでき、リンクは widget ターゲットの
  # OTHER_LDFLAGS に -framework FirebaseCore/FirebaseAuth/FirebaseFirestore を追加して解決する
  # （project.pbxproj 側で設定）。実行時は host app が埋め込むフレームワークを
  # @rpath(@executable_path/../../Frameworks)経由で読み込む。
  target 'ShoppingListWidgetExtension' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

  if target.name == 'BoringSSL-GRPC'
      target.source_build_phase.files.each do |file|
        if file.settings && file.settings['COMPILER_FLAGS']
          flags = file.settings['COMPILER_FLAGS'].split
          flags.reject! { |flag| flag == '-GCC_WARN_INHIBIT_ALL_WARNINGS' }
          file.settings['COMPILER_FLAGS'] = flags.join(' ')
        end
      end
    end

    target.build_configurations.each do |config|
      config.build_settings['ENABLE_BITCODE'] = 'NO'

      # Xcode 27.1 は iOS Simulator の deployment target が 15.0 未満の target を
      # "Target Integrity" エラーでビルドしない (実測: 27A9275 で Firebase の依存 (BoringSSL-GRPC・abseil 等。
      # podspec の下限が 9.0〜14.0) が落ちた)。Flutter に依存する pod は podhelper が Runner の値を
      # 継承させるが、Flutter に依存しない pod は podspec の値のまま残るため、アプリの最低バージョンまで引き上げる
      # (アプリより低い OS では動かないので挙動は変わらない)
      deployment_target = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if deployment_target && deployment_target.to_f < IOS_PLATFORM_VERSION.to_f
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = IOS_PLATFORM_VERSION
      end

      # workaround: https://github.com/CocoaPods/CocoaPods/issues/11196#issuecomment-1058716826
      if config.build_settings['WRAPPER_EXTENSION'] == 'bundle'
        config.build_settings['DEVELOPMENT_TEAM'] = 'TQPN82UBBY'
      end
    end
  end

  # Widget拡張(ShoppingListWidgetExtension)は inherit! :search_paths のため自前のリンクフラグを持たず、
  # Firestore の transitive 依存(absl/grpc 等)の未定義シンボルでリンク失敗する。そこで host app(Runner)の
  # OTHER_LDFLAGS から「Flutter プラグイン由来のフレームワーク(Flutter エンジンに依存し拡張ではリンク不可)」を
  # 除いたものを widget に付与し、host app が埋め込むネイティブ Firebase フレームワークをリンク＆実行時参照する
  # （archive の二重ビルドは inherit により回避済み。Firebase は host app のみに置く公式推奨構成）。
  # Runner の生成済み OTHER_LDFLAGS を読むので pod 構成が変わっても自動追従する。
  require 'json'
  runner_agg = installer.aggregate_targets.find { |t| t.name == 'Pods-Runner' }
  widget_agg = installer.aggregate_targets.find { |t| t.name == 'Pods-ShoppingListWidgetExtension' }
  if runner_agg && widget_agg
    deps_path = File.expand_path(File.join('..', '.flutter-plugins-dependencies'), File.dirname(File.realpath(__FILE__)))
    flutter_plugins = File.exist?(deps_path) ? ((JSON.parse(File.read(deps_path)).dig('plugins', 'ios') || []).map { |p| p['name'] }) : []
    # 広告系 SDK は Widget Extension で一切使わず、extension 非対応 API を含むため
    # archive の extension-safe 検証に失敗し得る。プラグイン名の除外だけでは Runner の
    # OTHER_LDFLAGS に残るため明示的に除外する (PR #520 レビュー指摘)。
    # google_mobile_ads は Issue #540 で撤去済みだが、GoogleAdsOnDeviceConversion は
    # firebase_analytics (GoogleAppMeasurement) の依存として今も Pods に残るため本リストは必要。
    # 名前は Pods-Runner の OTHER_LDFLAGS に現れる実フレームワーク名に合わせること。
    ad_sdk_frameworks = [
      'GoogleMobileAds',
      'Google_Mobile_Ads_SDK',
      'GoogleAdsOnDeviceConversion',
      'UserMessagingPlatform',
    ]
    exclude = flutter_plugins + ['Flutter'] + ad_sdk_frameworks
    widget_agg.user_targets.each do |user_target|
      user_target.build_configurations.each do |config|
        runner_xcconfig = runner_agg.xcconfigs[config.name]
        next unless runner_xcconfig
        flags = runner_xcconfig.to_hash['OTHER_LDFLAGS']
        flags = flags.join(' ') if flags.is_a?(Array)
        next unless flags
        exclude.each { |name| flags = flags.gsub(/-framework\s+"#{Regexp.escape(name)}"/, '') }
        config.build_settings['OTHER_LDFLAGS'] = "$(inherited) #{flags}"
      end
    end
    widget_agg.user_project.save
  end
end

